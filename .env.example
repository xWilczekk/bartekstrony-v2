# Skopiuj ten plik do .env.local i uzupełnij wartości.
# Zapytania z formularzy trafiają wyłącznie do panelu /control (Vercel Blob, niżej) — bez maili.

# Darmowy audyt (/audyt) korzysta z Google PageSpeed Insights. Bez klucza Google daje 0 testów
# dziennie i każdy audyt kończy się komunikatem o wyczerpanym limicie.
# Klucz: Google Cloud Console → włącz "PageSpeed Insights API" → Dane logowania → Utwórz klucz API.
# Ogranicz go do witryn https://bartekstrony.pl/* i http://localhost:3000/* oraz do PageSpeed Insights API.
NEXT_PUBLIC_PSI_API_KEY=

# Statystyki odwiedzin — Google Analytics 4 (ładuje się dopiero po zgodzie z banera „paragon”).
# Identyfikator pomiaru (G-MDNK5612M2) jest już w kodzie (src/lib/consent.ts). Ta zmienna jest opcjonalna — nadpisuje go.
NEXT_PUBLIC_GA_ID=

# Panel /control (zapytania + statystyki).
# Hasło do logowania — min. 8 znaków. Zmiana hasła wylogowuje wszystkie sesje.
CONTROL_PASSWORD=
# Opcjonalnie: osobny sekret do podpisywania sesji (domyślnie liczony z hasła).
CONTROL_SECRET=

# Vercel Blob — magazyn zapytań. Utwórz store jako PRIVATE (Storage → Blob → Create → Private)
# i połącz z projektem: Vercel sam doda BLOB_READ_WRITE_TOKEN. Lokalnie bez tokenu zapytania
# zapisują się do .data/leads.
BLOB_READ_WRITE_TOKEN=

# Statystyki w panelu: Google Analytics Data API (darmowe), przez konto usługi Google Cloud.
# 1) console.cloud.google.com → nowy projekt → włącz „Google Analytics Data API”
# 2) IAM → Konta usługi → utwórz → Klucze → Dodaj klucz → JSON
# 3) GA → Administracja → Zarządzanie dostępem do usługi → dodaj e-mail konta usługi jako „Czytelnik”
# GA_PROPERTY_ID: sam numer z GA → Administracja → Szczegóły usługi.
# GA_CLIENT_EMAIL i GA_PRIVATE_KEY: pola client_email i private_key z pliku JSON (cały klucz, razem z \n).
GA_PROPERTY_ID=
GA_CLIENT_EMAIL=
GA_PRIVATE_KEY=
